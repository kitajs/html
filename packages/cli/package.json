{
  "name": "@kitajs/html-cli",
  "version": "5.0.0-next.0",
  "description": "Command line tools for @kitajs/html, including XSS checks for TypeScript 7.1+",
  "homepage": "https://html.kitajs.org/guide/xss/cli-scanner",
  "bugs": "https://github.com/kitajs/html/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitajs/html.git",
    "directory": "packages/cli"
  },
  "funding": "https://github.com/kitajs/html?sponsor=1",
  "license": "MIT",
  "author": "Arthur Fiorette <kita@arthur.place>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./schema/check-report.v1.json": "./schema/check-report.v1.json"
  },
  "bin": {
    "kita-html": "bin/kita-html.js"
  },
  "files": [
    "bin",
    "dist",
    "schema",
    "!dist/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsgo -p tsconfig.build.json",
    "test": "vitest --coverage --run",
    "test-types": "tsgo --noEmit"
  },
  "oclif": {
    "bin": "kita-html",
    "commands": "./dist/cli/commands",
    "dirname": "kita-html",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-not-found",
      "@oclif/plugin-warn-if-update-available",
      "@oclif/plugin-version",
      "@oclif/plugin-autocomplete"
    ],
    "topicSeparator": " ",
    "warn-if-update-available": {
      "frequency": 1,
      "frequencyUnit": "days",
      "timeoutInDays": 7
    }
  },
  "dependencies": {
    "@oclif/core": "^5.1.7",
    "@oclif/plugin-autocomplete": "^4.0.4",
    "@oclif/plugin-help": "^7.0.4",
    "@oclif/plugin-not-found": "^4.0.4",
    "@oclif/plugin-version": "^3.0.5",
    "@oclif/plugin-warn-if-update-available": "^4.0.3"
  },
  "devDependencies": {
    "@kitajs/html": "workspace:^",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:ts7",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@kitajs/html": "workspace:^",
    "typescript": "^7.1.0-0"
  },
  "engines": {
    "node": ">=22"
  }
}
