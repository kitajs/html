{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kita-html check --format json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "tool", "typescript", "projects", "summary", "diagnostics"],
  "properties": {
    "version": {
      "const": 1
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "const": "@kitajs/html-cli"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "typescript": {
      "type": "string"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filesChecked", "errors", "warnings"],
      "properties": {
        "filesChecked": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "code", "id", "severity", "message", "url", "start", "end"],
        "properties": {
          "file": {
            "type": "string"
          },
          "code": {
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "severity": {
            "enum": ["error", "warning"]
          },
          "message": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "start": {
            "$ref": "#/$defs/location"
          },
          "end": {
            "$ref": "#/$defs/location"
          }
        }
      }
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "column", "offset"],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
