{
  "name": "@kitajs/ts-html-plugin",
  "version": "5.0.0-next.2",
  "description": "Deprecated TypeScript 6 language service plugin and xss-scan CLI for Kita Html. Use kita-html check from @kitajs/html-cli on TypeScript 7.1+",
  "homepage": "https://html.kitajs.org/guide/xss/ts-html-plugin",
  "bugs": "https://github.com/kitajs/html/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitajs/html.git",
    "directory": "packages/ts-html-plugin"
  },
  "funding": "https://github.com/kitajs/html?sponsor=1",
  "license": "MIT",
  "author": "Arthur Fiorette <kita@arthur.place>",
  "sideEffects": false,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ts-html-plugin": "bin/index.js",
    "xss-scan": "bin/index.js"
  },
  "files": [
    "dist",
    "src",
    "!dist/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsgo -p tsconfig.build.json",
    "test": "vitest --coverage --typecheck --run",
    "test-types": "tsgo --noEmit"
  },
  "dependencies": {
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@kitajs/html": "workspace:^",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "fast-defer": "^1.1.9",
    "self-ts-plugin": "link:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@kitajs/html": "workspace:^",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20.12"
  },
  "deprecated": "Requires TypeScript 6. Use TypeScript 7.1+ with kita-html check from @kitajs/html-cli instead. See https://html.kitajs.org/guide/xss/cli-scanner"
}
