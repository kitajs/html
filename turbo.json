{
  "$schema": "https://turborepo.dev/schema.json",
  "concurrency": "90%",
  "daemon": false,
  // Set in CI so we can distinguish cache for each OS
  "globalEnv": ["TURBO_OS_ENV", "TURBO_NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputLogs": "new-only",
      "outputs": ["dist"],
      "env": ["ZE_CI_TOKEN"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputLogs": "new-only"
    },
    "test-types": {
      "dependsOn": ["^build"],
      "outputLogs": "new-only"
    },
    "benchmark": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputLogs": "full"
    },
    "start": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputLogs": "new-only",
      "persistent": true
    }
  },
  "ui": "tui"
}
